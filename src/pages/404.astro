---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const icons = {
  alert: `<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`
};
---

<!-- Passing noindex={true} here so it can be controlled by Layout.astro later -->
<Layout title="Page Not Found | JMS Multi-Service Solutions" noindex={true}>
  
  <section class="min-h-[75vh] flex flex-col items-center justify-center bg-slate-50 px-4 text-center pt-40 pb-24 relative overflow-hidden">
    
    <!-- Subtle Background Pattern -->
    <div class="absolute inset-0 pointer-events-none z-0" style="mask-image: linear-gradient(to bottom, black 50%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 50%, transparent 100%);">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="404-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <path d="M0 100 V 50 Q 25 25 50 50 T 100 50 V 100 z" fill="none" stroke="#cbd5e1" stroke-width="0.5" opacity="0.3"/>
            <circle cx="50" cy="50" r="1" fill="#cbd5e1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#404-pattern)" />
      </svg>
    </div>

    <div class="relative z-10 fade-up-element max-w-2xl mx-auto">
      
      <div class="text-brand-accent mb-6 flex justify-center">
        <Fragment set:html={icons.alert} />
      </div>
      
      <h1 class="text-7xl md:text-9xl font-black text-brand-deep tracking-tighter mb-4 drop-shadow-sm">
        404
      </h1>
      
      <div class="w-24 h-2 bg-brand-primary mx-auto mb-8"></div>
      
      <h2 class="text-2xl md:text-3xl font-black uppercase text-brand-deep mb-4 tracking-tight">
        Looks like you're off the map
      </h2>
      
      <p class="text-slate-500 font-bold mb-10 md:text-lg leading-relaxed">
        The page you are looking for might have been removed, had its name changed, or is temporarily unavailable. Let's get you back to safe ground.
      </p>
      
      <a href="/" class="inline-block bg-brand-primary text-white px-10 py-5 font-black uppercase text-sm tracking-[0.2em] hover:bg-brand-accent transition-all shadow-[6px_6px_0px_#111827]">
        Return to Homepage
      </a>
      
    </div>
  </section>
  
  <Footer />
</Layout>

<style>
  .fade-up-element { 
    opacity: 0; 
    animation: fadeUp 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards; 
  }
  @keyframes fadeUp { 
    0% { opacity: 0; transform: translateY(40px); } 
    100% { opacity: 1; transform: translateY(0); } 
  }
</style>