---
const images = [
  '/images/hero1.jpg',  
  'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?q=80&w=1920&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=1920&auto=format&fit=crop',
];

const icons = {
  wash: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg>`,
  roof: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>`,
  paving: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="3" y1="15" x2="21" y2="15"></line><line x1="9" y1="9" x2="9" y2="21"></line><line x1="15" y1="3" x2="15" y2="15"></line></svg>`
};
---

<section class="relative lg:h-screen min-h-[950px] flex flex-col bg-brand-deep z-30 pt-28 lg:pt-0">
  
  <div class="absolute inset-0 z-0 overflow-hidden">
    {images.map((img, index) => (
      <div class={`hero-bg bg-${index + 1}`} style={`background-image: url('${img}');`}></div>
    ))}
  </div>

  <div class="absolute inset-0 bg-brand-deep/50 md:bg-brand-deep/40 z-10 pointer-events-none"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-brand-deep/80 via-transparent to-transparent z-10 pointer-events-none"></div>

  <div class="flex-1 flex flex-col items-center justify-center relative z-20 w-full">
    
    <div class="text-center px-4 max-w-5xl mx-auto mt-0 lg:-translate-y-32">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white uppercase tracking-tight leading-tight mb-6 animate-slide-in-left">
        Driveway & Roof Revival In <span class="text-brand-accent">Hull</span>
      </h1>
      <p class="text-lg md:text-2xl font-bold text-slate-300 mb-10 max-w-3xl mx-auto animate-slide-in-right">
        Hull's #1 choice for premium exterior cleaning, block paving, and roof repairs. We breathe new life into your property.
      </p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center animate-fade-up-buttons">
        <a href="tel:07785689946" class="w-full sm:w-auto bg-brand-accent text-brand-deep px-10 py-5 font-black uppercase text-sm tracking-[0.2em] hover:bg-brand-primary hover:text-white transition-all shadow-[6px_6px_0px_#0f172a]">
          Call: 07785 689946
        </a>
        <button id="heroQuoteBtn" class="w-full sm:w-auto bg-transparent border-4 border-brand-primary text-white px-10 py-4 font-black uppercase text-sm tracking-[0.2em] hover:bg-brand-primary transition-all cursor-pointer">
          Get a Quote
        </button>
      </div>
    </div>
  </div>

  <div class="hero-boxes-container relative lg:absolute bottom-0 translate-y-16 lg:translate-y-1/2 z-40 w-full px-4 mt-8 lg:mt-0 -mb-8 lg:mb-0">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-12 lg:px-10">
      
      <div class="industrial-box box-left bg-white border-b-8 border-slate-200 p-8 shadow-2xl relative z-10 flex flex-col items-center text-center">
        <div class="text-brand-primary mb-4"><Fragment set:html={icons.wash} /></div>
        <h3 class="text-xl font-black uppercase text-brand-deep mb-2">Driveway Cleaning</h3>
        <p class="text-sm font-semibold text-slate-500">Hypo-treated pressure washing, sanding, and resin sealing.</p>
      </div>

      <div class="industrial-box box-middle bg-brand-deep text-white border-b-8 border-brand-accent p-10 shadow-[0px_20px_40px_rgba(0,115,230,0.2)] relative z-20 flex flex-col items-center text-center">
        <div class="text-brand-accent mb-4"><Fragment set:html={icons.roof} /></div>
        <h3 class="text-2xl font-black uppercase mb-2">Roof Repairs</h3>
        <p class="text-sm font-medium text-slate-300">Missing tiles replaced, leaks fixed, and full roof cleaning services.</p>
        
        <div class="bridge-line bridge-left hidden lg:block">
          <div class="bridge-ball"></div>
        </div>
        
        <div class="bridge-line bridge-right hidden lg:block">
          <div class="bridge-ball"></div>
        </div>
      </div>

      <div class="industrial-box box-right bg-white border-b-8 border-slate-200 p-8 shadow-2xl relative z-10 flex flex-col items-center text-center">
        <div class="text-brand-primary mb-4"><Fragment set:html={icons.paving} /></div>
        <h3 class="text-xl font-black uppercase text-brand-deep mb-2">Block Paving</h3>
        <p class="text-sm font-semibold text-slate-500">Expert installation, repointing, and full decking restoration.</p>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    animation: kenburns 18s infinite linear;
    z-index: 0;
  }
  .bg-1 { animation-delay: 0s; opacity: 1; }
  .bg-2 { animation-delay: 6s; }
  .bg-3 { animation-delay: 12s; }

  @keyframes kenburns {
    0% { opacity: 0; transform: scale(1); }
    10% { opacity: 1; }
    33% { opacity: 1; transform: scale(1.08); } 
    43% { opacity: 0; transform: scale(1.1); }
    100% { opacity: 0; }
  }

  .animate-slide-in-left { animation: slideInLeft 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards; }
  .animate-slide-in-right { animation: slideInRight 1.2s cubic-bezier(0.25, 1, 0.5, 1) 0.3s forwards; opacity: 0; }
  .animate-fade-up-buttons { animation: fadeUp 1s cubic-bezier(0.25, 1, 0.5, 1) 0.8s forwards; opacity: 0; }

  @keyframes slideInLeft {
    0% { opacity: 0; transform: translateX(-100px); }
    100% { opacity: 1; transform: translateX(0); }
  }
  @keyframes slideInRight {
    0% { opacity: 0; transform: translateX(100px); }
    100% { opacity: 1; transform: translateX(0); }
  }
  @keyframes fadeUp {
    0% { opacity: 0; transform: translateY(40px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .box-middle { opacity: 0; transform: translateY(100px); }
  .box-left { opacity: 0; transform: translate(-40px, 0); }
  .box-right { opacity: 0; transform: translate(40px, 0); }
  
  .bridge-line { width: 0px; background-color: #0073e6; position: absolute; top: 50%; transform: translateY(-50%); height: 4px; z-index: -1; }
  .bridge-left { right: 100%; }
  .bridge-right { left: 100%; }
  .bridge-ball { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0); width: 14px; height: 14px; background-color: #0f172a; border: 3px solid #ffcc00; border-radius: 50%; }

  .is-visible .box-middle {
    animation: riseUp 0.8s cubic-bezier(0.25, 1, 0.5, 1) 0.2s forwards;
  }
  .is-visible .bridge-line {
    animation: extendBridge 0.4s ease-out 0.7s forwards;
  }
  .is-visible .bridge-ball {
    animation: popBall 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) 1.0s forwards;
  }
  .is-visible .box-left {
    animation: slideBoxLeft 0.8s cubic-bezier(0.25, 1, 0.5, 1) 1.0s forwards;
  }
  .is-visible .box-right {
    animation: slideBoxRight 0.8s cubic-bezier(0.25, 1, 0.5, 1) 1.0s forwards;
  }

  @keyframes riseUp { 100% { opacity: 1; transform: translateY(0); } }
  @keyframes slideBoxLeft { 100% { opacity: 1; transform: translate(0, 0); } }
  @keyframes slideBoxRight { 100% { opacity: 1; transform: translate(0, 0); } }
  @keyframes extendBridge { 100% { width: 48px; } }
  @keyframes popBall { 100% { transform: translate(-50%, -50%) scale(1); } }
</style>

<script>
  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target); 
      }
    });
  }, { threshold: 0.2 });

  const boxContainer = document.querySelector('.hero-boxes-container');
  if (boxContainer) {
    observer.observe(boxContainer);
  }

  const heroQuoteBtn = document.getElementById('heroQuoteBtn');
  heroQuoteBtn?.addEventListener('click', () => {
    const modal = document.getElementById('quoteModal');
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  });
</script>