---
const images = [
  '/images/hero1.jpg',  
  '/images/hero2.jpg',
  '/images/hero3.jpg',
];

const icons = {
  leaf: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`,
  wash: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path><path d="M12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path></svg>`,
  tool: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`
};
---

<section class="relative lg:h-screen min-h-[950px] flex flex-col bg-brand-deep z-30 pt-28 lg:pt-0">
  
  <div class="absolute inset-0 z-0 overflow-hidden">
    {images.map((img, index) => (
      <div class={`hero-bg bg-${index + 1}`} style={`background-image: url('${img}');`}></div>
    ))}
  </div>

  <div class="absolute inset-0 bg-brand-deep/50 md:bg-brand-deep/40 z-10 pointer-events-none"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-brand-deep/90 via-transparent to-transparent z-10 pointer-events-none"></div>

  <div class="flex-1 flex flex-col items-center justify-center relative z-20 w-full">
    
    <div class="text-center px-4 max-w-5xl mx-auto mt-0 lg:-translate-y-32">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white uppercase tracking-tight leading-tight mb-6 animate-slide-in-left">
        Property Solutions In <br/><span class="text-brand-primary">East Riding</span>
      </h1>
      <p class="text-lg md:text-2xl font-bold text-slate-200 mb-10 max-w-3xl mx-auto animate-slide-in-right">
        One call for complete solutions. Expert garden maintenance, powerful jet washing, and reliable handyman services across East Riding & North Lincs.
      </p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center animate-fade-up-buttons">
        <a href="tel:07518872477" class="w-full sm:w-auto bg-brand-primary text-white px-10 py-5 font-black uppercase text-sm tracking-[0.2em] hover:bg-brand-accent hover:text-white transition-all shadow-[6px_6px_0px_#111827]">
          Call: 07518 872477
        </a>
        <button id="heroQuoteBtn" class="w-full sm:w-auto bg-transparent border-4 border-brand-accent text-white px-10 py-4 font-black uppercase text-sm tracking-[0.2em] hover:bg-brand-accent transition-all cursor-pointer">
          Get a Quote
        </button>
      </div>
    </div>
  </div>

  <div class="hero-boxes-container relative lg:absolute bottom-0 translate-y-16 lg:translate-y-1/2 z-40 w-full px-4 mt-8 lg:mt-0 -mb-8 lg:mb-0">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-12 lg:px-10">
      
      <div class="industrial-box box-left bg-white border-b-8 border-slate-200 p-8 shadow-2xl relative z-10 flex flex-col items-center text-center">
        <div class="text-brand-primary mb-4"><Fragment set:html={icons.leaf} /></div>
        <h3 class="text-xl font-black uppercase text-brand-deep mb-2">Garden Maintenance</h3>
        <p class="text-sm font-semibold text-slate-500">Lawn care, weed removal, and full garden clearances.</p>
      </div>

      <div class="industrial-box box-middle bg-brand-deep text-white border-b-8 border-brand-accent p-10 shadow-[0px_20px_40px_rgba(57,169,245,0.2)] relative z-20 flex flex-col items-center text-center">
        <div class="text-brand-accent mb-4"><Fragment set:html={icons.wash} /></div>
        <h3 class="text-2xl font-black uppercase mb-2">Jet Washing</h3>
        <p class="text-sm font-medium text-slate-300">Powerful cleaning for driveways, patios, and building exteriors.</p>
        
        <div class="bridge-line bridge-left hidden lg:block">
          <div class="bridge-ball"></div>
        </div>
        
        <div class="bridge-line bridge-right hidden lg:block">
          <div class="bridge-ball"></div>
        </div>
      </div>

      <div class="industrial-box box-right bg-white border-b-8 border-slate-200 p-8 shadow-2xl relative z-10 flex flex-col items-center text-center">
        <div class="text-brand-primary mb-4"><Fragment set:html={icons.tool} /></div>
        <h3 class="text-xl font-black uppercase text-brand-deep mb-2">Handyman Services</h3>
        <p class="text-sm font-semibold text-slate-500">General repairs, fencing, decking, and property upkeep.</p>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    animation: kenburns 18s infinite linear;
    z-index: 0;
  }
  .bg-1 { animation-delay: 0s; opacity: 1; }
  .bg-2 { animation-delay: 6s; }
  .bg-3 { animation-delay: 12s; }

  @keyframes kenburns {
    0% { opacity: 0; transform: scale(1); }
    10% { opacity: 1; }
    33% { opacity: 1; transform: scale(1.08); } 
    43% { opacity: 0; transform: scale(1.1); }
    100% { opacity: 0; }
  }

  .animate-slide-in-left { animation: slideInLeft 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards; }
  .animate-slide-in-right { animation: slideInRight 1.2s cubic-bezier(0.25, 1, 0.5, 1) 0.3s forwards; opacity: 0; }
  .animate-fade-up-buttons { animation: fadeUp 1s cubic-bezier(0.25, 1, 0.5, 1) 0.8s forwards; opacity: 0; }

  @keyframes slideInLeft {
    0% { opacity: 0; transform: translateX(-100px); }
    100% { opacity: 1; transform: translateX(0); }
  }
  @keyframes slideInRight {
    0% { opacity: 0; transform: translateX(100px); }
    100% { opacity: 1; transform: translateX(0); }
  }
  @keyframes fadeUp {
    0% { opacity: 0; transform: translateY(40px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .box-middle { opacity: 0; transform: translateY(100px); }
  .box-left { opacity: 0; transform: translate(-40px, 0); }
  .box-right { opacity: 0; transform: translate(40px, 0); }
  
  /* Updated to new JMS brand colors: Green bridge lines, Slate balls with Blue borders */
  .bridge-line { width: 0px; background-color: #8ebe29; position: absolute; top: 50%; transform: translateY(-50%); height: 4px; z-index: -1; }
  .bridge-left { right: 100%; }
  .bridge-right { left: 100%; }
  .bridge-ball { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0); width: 14px; height: 14px; background-color: #111827; border: 3px solid #39a9f5; border-radius: 50%; }

  .is-visible .box-middle {
    animation: riseUp 0.8s cubic-bezier(0.25, 1, 0.5, 1) 0.2s forwards;
  }
  .is-visible .bridge-line {
    animation: extendBridge 0.4s ease-out 0.7s forwards;
  }
  .is-visible .bridge-ball {
    animation: popBall 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) 1.0s forwards;
  }
  .is-visible .box-left {
    animation: slideBoxLeft 0.8s cubic-bezier(0.25, 1, 0.5, 1) 1.0s forwards;
  }
  .is-visible .box-right {
    animation: slideBoxRight 0.8s cubic-bezier(0.25, 1, 0.5, 1) 1.0s forwards;
  }

  @keyframes riseUp { 100% { opacity: 1; transform: translateY(0); } }
  @keyframes slideBoxLeft { 100% { opacity: 1; transform: translate(0, 0); } }
  @keyframes slideBoxRight { 100% { opacity: 1; transform: translate(0, 0); } }
  @keyframes extendBridge { 100% { width: 48px; } }
  @keyframes popBall { 100% { transform: translate(-50%, -50%) scale(1); } }
</style>

<script>
  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target); 
      }
    });
  }, { threshold: 0.2 });

  const boxContainer = document.querySelector('.hero-boxes-container');
  if (boxContainer) {
    observer.observe(boxContainer);
  }

  const heroQuoteBtn = document.getElementById('heroQuoteBtn');
  heroQuoteBtn?.addEventListener('click', () => {
    const modal = document.getElementById('quoteModal');
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  });
</script>