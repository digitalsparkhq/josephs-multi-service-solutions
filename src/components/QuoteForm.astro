<div id="quoteModal" class="fixed inset-0 bg-brand-deep/90 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-4">
  <div id="modalBackdrop" class="absolute inset-0 cursor-pointer"></div>
  
  <div class="relative z-10 bg-white w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-none shadow-2xl border-4 border-brand-primary">
    <div class="p-5 md:p-6 bg-brand-deep text-white flex justify-between items-center border-b-4 border-brand-accent">
      <h2 class="text-lg md:text-xl font-black uppercase tracking-tighter italic">Get a Free Quote</h2>
      <button id="closeQuoteBtn" class="text-3xl hover:text-brand-accent transition-colors cursor-pointer">&times;</button>
    </div>
    
    <form id="waQuoteForm" class="p-6 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-5">
      <input type="text" id="waFirstName" placeholder="First Name" class="border-b-2 border-slate-200 p-3 focus:border-brand-primary outline-none font-bold text-sm text-brand-deep" required />
      <input type="text" id="waLastName" placeholder="Last Name" class="border-b-2 border-slate-200 p-3 focus:border-brand-primary outline-none font-bold text-sm text-brand-deep" required />
      
      <input type="text" id="waPhone" placeholder="Phone Number" class="border-b-2 border-slate-200 p-3 md:col-span-1 outline-none font-bold text-sm text-brand-deep" required />
      <input type="text" id="waPostcode" placeholder="Postcode / Town (e.g. Hull)" class="border-b-2 border-slate-200 p-3 md:col-span-1 outline-none font-bold text-sm text-brand-deep" required />

      <div class="md:col-span-2 space-y-4 pt-4 border-t border-slate-100">
        <label class="block font-black text-[10px] uppercase tracking-widest text-brand-primary">Project Requirements</label>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <select id="waService" class="w-full border-b-2 border-slate-200 p-3 outline-none bg-white font-bold text-brand-deep text-sm cursor-pointer" required>
            <option value="" disabled selected>Service Required...</option>
            <option value="Driveway Cleaning">Driveway Cleaning & Refurbishment</option>
            <option value="Block Paving">Block Paving (Install or Repair)</option>
            <option value="Patio Restoration">Patio Cleaning & Relaying</option>
            <option value="Roof Cleaning & Repairs">Roof Cleaning & Repairs</option>
            <option value="Decking Cleaning">Decking Restoration & Cleaning</option>
            <option value="General Enquiry">Other / Multiple Services</option>
          </select>

          <select id="waTimescale" class="w-full border-b-2 border-slate-200 p-3 outline-none bg-white font-bold text-brand-deep text-sm cursor-pointer" required>
            <option value="" disabled selected>Timescale...</option>
            <option value="ASAP">ASAP</option>
            <option value="Within 1-2 Weeks">Within 1-2 Weeks</option>
            <option value="Within 1 Month">Within 1 Month</option>
            <option value="Planning Stage / Quote Only">Flexible / Quote Only</option>
          </select>
        </div>
        
        <textarea id="waDetails" placeholder="Brief Description of Enquiry (e.g. 3 bed semi roof clean, or block paving repair...)" class="w-full border-2 border-slate-100 p-4 h-24 focus:border-brand-primary outline-none bg-slate-50 text-sm text-brand-deep" required></textarea>
      </div>

      <button type="submit" class="md:col-span-2 bg-brand-accent text-brand-deep font-black py-4 px-6 uppercase tracking-[0.15em] text-sm hover:bg-brand-primary hover:text-white transition-all shadow-[4px_4px_0px_#0f172a] active:translate-x-1 active:translate-y-1 active:shadow-none cursor-pointer mt-2 flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
        Send via WhatsApp
      </button>
    </form>
  </div>
</div>

<script>
  const modal = document.getElementById('quoteModal');
  const closeBtn = document.getElementById('closeQuoteBtn');
  const backdrop = document.getElementById('modalBackdrop');
  const waForm = document.getElementById('waQuoteForm') as HTMLFormElement;

  const closeModal = () => {
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = 'auto'; 
    }
  };

  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);

  // WhatsApp Form Submission
  waForm?.addEventListener('submit', (e) => {
    e.preventDefault();

    const clientWhatsAppNumber = "447785689946"; 
    
    // Grab all values including the timescale
    const fName = (document.getElementById('waFirstName') as HTMLInputElement).value;
    const lName = (document.getElementById('waLastName') as HTMLInputElement).value;
    const phone = (document.getElementById('waPhone') as HTMLInputElement).value;
    const postcode = (document.getElementById('waPostcode') as HTMLInputElement).value;
    const service = (document.getElementById('waService') as HTMLSelectElement).value;
    const timescale = (document.getElementById('waTimescale') as HTMLSelectElement).value;
    const details = (document.getElementById('waDetails') as HTMLTextAreaElement).value;

    // Construct the WhatsApp message with Timescale added
    const whatsappText = `Hi R Penfold Drive Revive, I'd like to request a quote.%0A%0A*Name:* ${fName} ${lName}%0A*Phone:* ${phone}%0A*Location:* ${postcode}%0A*Service:* ${service}%0A*Timescale:* ${timescale}%0A*Details:* ${details}`;

    // Open WhatsApp link
    const waLink = `https://wa.me/${clientWhatsAppNumber}?text=${whatsappText}`;
    window.open(waLink, '_blank');

    closeModal();
    waForm.reset();
  });
</script>