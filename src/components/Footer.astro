---
const currentYear = new Date().getFullYear();

// Updated links for R Penfold Drive Revive
const facebookLink = "https://www.facebook.com/people/R-Penfold-Drive-revive/61584586783031/";
const whatsappLink = "https://wa.me/447785689946";
const agencyLink = "https://digitalsparkhq.com/";

// Changed 'stroke="white"' to 'stroke="currentColor"' for easier hover styling
const icons = {
  phone: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>`,
  mail: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>`,
  map: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>`,
  facebook: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>`,
  whatsapp: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 1 1-7.6-10.6 8.38 8.38 0 0 1 3.8.9L21 4.5z"/><path d="M15.5 13.5l-1.5-1.5M10.5 8.5l-1.5-1.5"/></svg>`
};
---

<footer class="bg-brand-deep text-white pt-20 pb-10 relative overflow-hidden">
  <div class="absolute top-0 left-0 w-full h-2 bg-brand-primary"></div>

  <div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16 text-center md:text-left">
      
      <div class="lg:col-span-1">
        <div class="mb-6 flex justify-center md:justify-start">
           <img src="/images/logo.png" alt="R Penfold Drive Revive Logo" class="h-16 w-auto object-contain" />
        </div>
        <p class="text-slate-300 font-medium leading-relaxed">
          Premier exterior cleaning, block paving, and roof repair specialist. Built on quality workmanship and unbeatable prices.
        </p>
      </div>

      <div>
        <h4 class="text-sm font-black uppercase tracking-widest text-brand-primary mb-6">Navigation</h4>
        <ul class="space-y-4 font-bold text-white uppercase text-xs tracking-widest">
          <li><a href="/" class="hover:text-brand-primary transition-colors">Home</a></li>
          <li><a href="/#services" class="hover:text-brand-primary transition-colors">Services</a></li>
          <li><a href="/#about" class="hover:text-brand-primary transition-colors">About Us</a></li>
          <li><a href="/#gallery" class="hover:text-brand-primary transition-colors">Project Gallery</a></li>
          <li><a href="/contact" class="hover:text-brand-primary transition-colors">Contact Us</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-black uppercase tracking-widest text-brand-primary mb-6">Get In Touch</h4>
        <ul class="space-y-6">
          <li class="flex flex-col md:flex-row items-center md:items-start gap-4">
            <span class="mt-1 text-brand-primary"><Fragment set:html={icons.phone} /></span>
            <div>
              <p class="text-xs font-black uppercase tracking-widest text-slate-400 mb-1">Call Robert</p>
              <a href="tel:07785689946" class="text-lg font-bold hover:text-brand-primary transition-colors">07785 689946</a>
            </div>
          </li>
          <li class="flex flex-col md:flex-row items-center md:items-start gap-4">
            <span class="mt-1 text-brand-primary"><Fragment set:html={icons.mail} /></span>
            <div>
              <p class="text-xs font-black uppercase tracking-widest text-slate-400 mb-1">Email Us</p>
              <a href="mailto:penfoldrobert3@gmail.com" class="font-bold hover:text-brand-primary transition-colors text-sm break-all">penfoldrobert3@gmail.com</a>
            </div>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-black uppercase tracking-widest text-brand-primary mb-6">Service Area</h4>
        <div class="flex flex-col md:flex-row items-center md:items-start gap-4 mb-8">
          <span class="mt-1 text-brand-primary"><Fragment set:html={icons.map} /></span>
          <div>
            <p class="font-bold">Sutton Rd, Doncaster</p>
            <p class="text-slate-300 text-sm mt-2 font-medium">Proudly serving Hull, Doncaster, and the wider Yorkshire area.</p>
          </div>
        </div>

        <div class="pl-0 md:pl-9">
          <h4 class="text-xs font-black uppercase tracking-widest text-slate-400 mb-4">Connect With Us</h4>
          <div class="flex justify-center md:justify-start gap-4">
            <a href={facebookLink} target="_blank" rel="noopener noreferrer" class="w-10 h-10 border border-white/20 flex items-center justify-center hover:bg-brand-primary hover:border-brand-primary transition-all text-white">
              <Fragment set:html={icons.facebook} />
            </a>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="w-10 h-10 border border-white/20 flex items-center justify-center hover:bg-green-600 hover:border-green-600 transition-all text-white">
              <Fragment set:html={icons.whatsapp} />
            </a>
          </div>
        </div>
      </div>

    </div>

    <div class="border-t border-white/10 pt-10 flex flex-col md:flex-row justify-between items-center gap-6">
      <p class="text-slate-400 text-xs font-bold uppercase tracking-widest text-center md:text-left">
        &copy; {currentYear} R Penfold Drive Revive.
      </p>
      <div class="flex items-center gap-6 text-xs font-bold uppercase tracking-widest text-slate-400">
         <p>Website by <a href={agencyLink} target="_blank" class="text-white hover:text-brand-primary transition-colors">Digital Spark HQ</a></p>
      </div>
    </div>
  </div>
</footer>