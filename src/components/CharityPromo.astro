---
import { Image } from 'astro:assets';
// Importing both the original and the new medal/tracker photos
import walkImage1 from '../assets/event.jpg'; 
import walkImage2 from '../assets/event2.jpg'; 

const justGivingLink = "https://www.justgiving.com/team/joseph-multi-service-solutions?utm_medium=TE&utm_source=CL";
---

<section class="bg-white relative overflow-hidden py-16 md:py-24 z-20 border-t-2 border-slate-100">
  <div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10 fade-up-element">
    
    <!-- Clean layout without the heavy promotional banner card -->
    <div class="flex flex-col md:flex-row items-center gap-10 md:gap-16">
      
      <!-- Images Side: Two images side-by-side, no cropping, clean subtle frames -->
      <div class="w-full md:w-5/12 flex gap-4 justify-center shrink-0">
        <div class="w-1/2 bg-white border-2 border-slate-200 shadow-[4px_4px_0px_#e2e8f0] p-1 md:p-2">
          <Image 
            src={walkImage1} 
            alt="JMS Charity Walk Event" 
            width={400}
            class="w-full h-auto block"
          />
        </div>
        <div class="w-1/2 bg-white border-2 border-slate-200 shadow-[4px_4px_0px_#e2e8f0] p-1 md:p-2">
          <Image 
            src={walkImage2} 
            alt="Trek 26 Medal and Distance Tracker" 
            width={400}
            class="w-full h-auto block"
          />
        </div>
      </div>

      <!-- Content Side: Updated text for past tense -->
      <div class="w-full md:w-7/12 text-center md:text-left">
        <h2 class="text-xs font-black uppercase tracking-[0.2em] text-brand-primary mb-2">Community Support</h2>
        <h3 class="text-3xl md:text-4xl font-black text-brand-deep uppercase tracking-tighter mb-4">
          We Completed the Trek 26 Charity Walk!
        </h3>
        <p class="text-slate-600 font-bold mb-8 md:text-lg max-w-2xl mx-auto md:mx-0 leading-relaxed">
          A massive thank you to everyone who supported the JMS team! We have officially completed the walk, but our donation page remains open until the end of July. We would massively appreciate any final donations to help us smash our target. Every little bit makes a difference!
        </p>
        
        <a href={justGivingLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-brand-primary text-white px-8 py-4 font-black uppercase text-sm tracking-[0.15em] shadow-[4px_4px_0px_#111827] hover:bg-brand-accent hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all">
          Sponsor the Team Here
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .fade-up-element { 
    opacity: 0; 
    transform: translateY(40px); 
    transition: opacity 0.8s ease-out, transform 0.8s ease-out; 
  }
  .fade-up-element.is-visible { 
    opacity: 1; 
    transform: translateY(0); 
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.fade-up-element').forEach((el) => observer.observe(el));
</script>