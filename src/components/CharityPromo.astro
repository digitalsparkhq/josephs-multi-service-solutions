---
import { Image } from 'astro:assets';
// UPDATE THIS extension if you uploaded it as offer.png instead of offer.jpg
import offerImage from '../assets/offer.jpg'; 

const facebookPostLink = "https://m.facebook.com/story.php?story_fbid=122118960489345949&id=61590378479449";
---

<section class="bg-white relative overflow-hidden py-16 md:py-24 z-20 border-t-2 border-slate-100">
  <div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10 fade-up-element">
    
    <div class="flex flex-col md:flex-row items-center gap-10 md:gap-16">
      
      <!-- Image Side: Single image layout for the competition flyer -->
      <div class="w-full md:w-5/12 shrink-0 flex justify-center">
        <div class="w-full max-w-sm bg-white border-2 border-slate-200 shadow-[4px_4px_0px_#e2e8f0] p-1 md:p-2">
          <Image 
            src={offerImage} 
            alt="JMS Free Jet Washing Giveaway" 
            width={600}
            class="w-full h-auto block"
          />
        </div>
      </div>

      <!-- Content Side: Formatted competition details -->
      <div class="w-full md:w-7/12 text-center md:text-left">
        <h2 class="text-xs font-black uppercase tracking-[0.2em] text-brand-primary mb-2">Competition Update</h2>
        <h3 class="text-3xl md:text-4xl font-black text-brand-deep uppercase tracking-tighter mb-4">
          Win a FREE Jet Wash!
        </h3>
        
        <p class="text-slate-600 font-bold mb-4 md:text-lg max-w-2xl mx-auto md:mx-0 leading-relaxed">
          Only a few days left! Our FREE Jet Washing Giveaway will be drawn <span class="text-brand-primary">LIVE this Sunday</span>. If you haven’t entered yet, there’s still time. One lucky winner will receive a free jet wash from JMS!
        </p>

        <div class="bg-slate-50 border-l-4 border-brand-primary p-4 mb-8 text-left max-w-xl mx-auto md:mx-0 shadow-sm">
          <p class="text-sm font-black text-brand-deep uppercase mb-2">How to enter:</p>
          <ul class="text-slate-600 font-medium space-y-2 text-sm md:text-base">
            <li class="flex items-center gap-2">
              <span class="text-brand-primary">✓</span> Like the original competition post
            </li>
            <li class="flex items-center gap-2">
              <span class="text-brand-primary">✓</span> Follow our page
            </li>
            <li class="flex items-center gap-2">
              <span class="text-brand-primary">✓</span> Share the post
            </li>
            <li class="flex items-center gap-2">
              <span class="text-brand-primary">✓</span> Comment once you’ve done all of the above
            </li>
          </ul>
        </div>
        
        <p class="text-slate-500 font-medium text-sm mb-6 max-w-2xl mx-auto md:mx-0">
          Thank you to everyone who has entered so far and for all the support you’ve shown our local business – it really does mean a lot! Good luck everyone!
        </p>
        
        <a href={facebookPostLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-[#1877F2] text-white px-8 py-4 font-black uppercase text-sm tracking-[0.15em] shadow-[4px_4px_0px_#111827] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all">
          Enter on Facebook Here
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .fade-up-element { 
    opacity: 0; 
    transform: translateY(40px); 
    transition: opacity 0.8s ease-out, transform 0.8s ease-out; 
  }
  .fade-up-element.is-visible { 
    opacity: 1; 
    transform: translateY(0); 
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.fade-up-element').forEach((el) => observer.observe(el));
</script>