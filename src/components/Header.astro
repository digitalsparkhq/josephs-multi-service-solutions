---
const pathname = new URL(Astro.url).pathname;
// This safely removes leading and trailing slashes so '/' and '/contact/' become '' and 'contact'
const currentPath = pathname.replace(/^\/|\/$/g, '');

const navItems = [
  { name: 'Home', href: '/#' },
  { name: 'Services', href: '/#services' },
  { name: 'Gallery', href: '/#gallery' },
  { name: 'About Us', href: '/#about' },
  { name: 'Contact Us', href: '/contact' },
];

// Optimized SVGs including Instagram and TikTok
const icons = {
  phone: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l2.18-2.18a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>`,
  mail: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>`,
  mapPin: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>`,
  facebook: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>`,
  instagram: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>`,
  tiktok: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>`,
  whatsapp: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>`,
  menu: `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>`,
  close: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>`
};
---

<header class="relative w-full z-50">
  <!-- Top Bar -->
  <div class="bg-brand-deep text-white py-4 px-4 md:px-8 border-b border-brand-primary">
    <div class="max-w-7xl mx-auto flex justify-between items-center text-xs md:text-sm font-medium tracking-wide">
      <div class="flex gap-8 items-center">
        <a href="tel:07518872477" class="flex items-center gap-2 hover:text-brand-primary transition-colors cursor-pointer">
          <span class="text-brand-primary flex" set:html={icons.phone} /> 07518 872477
        </a>
        <a href="mailto:jmssolutionsuk@gmail.com" class="hidden sm:flex items-center gap-2 hover:text-brand-primary transition-colors cursor-pointer">
          <span class="text-brand-primary flex" set:html={icons.mail} /> jmssolutionsuk@gmail.com
        </a>
        <span class="hidden lg:flex items-center gap-2 text-white">
          <span class="text-brand-primary flex" set:html={icons.mapPin} /> Serving East Riding & North Lincs
        </span>
      </div>
      <div class="flex gap-4 sm:gap-5 items-center">
        <a href="https://www.facebook.com/people/Josephs-Multi-Service-Solutions/61590378479449/" target="_blank" class="hover:text-brand-primary transition-all cursor-pointer text-white">
          <Fragment set:html={icons.facebook} />
        </a>
        <a href="https://www.instagram.com/jms_solutions_uk" target="_blank" class="hover:text-brand-primary transition-all cursor-pointer text-white">
          <Fragment set:html={icons.instagram} />
        </a>
        <a href="https://www.tiktok.com/@jms_solutions_uk" target="_blank" class="hover:text-brand-primary transition-all cursor-pointer text-white">
          <Fragment set:html={icons.tiktok} />
        </a>
        <a href="https://wa.me/447518872477" target="_blank" class="hover:text-brand-primary transition-all cursor-pointer text-white">
          <Fragment set:html={icons.whatsapp} />
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <nav class="bg-brand-deep border-b border-white/5 shadow-xl px-4 md:px-8">
    <div class="max-w-7xl mx-auto flex justify-between items-center h-24 md:h-28">
      <a href="/" class="h-16 md:h-22 transition-transform hover:scale-105 cursor-pointer">
        <img src="/images/logo.png" alt="JMS Multi-Service Solutions Logo" class="h-full w-auto object-contain" />
      </a>

      <div class="hidden lg:flex items-center gap-10">
        <ul class="flex gap-8">
          {navItems.map(item => {
            const isItemActive = (item.name === 'Home' && currentPath === '') || 
                                 (item.href.replace(/^\/|\/$/g, '') === currentPath && currentPath !== '');
            return (
              <li>
                <a href={item.href} class={`text-xs font-black uppercase tracking-[0.15em] transition-all py-2 border-b-2 cursor-pointer
                  ${isItemActive 
                    ? 'text-brand-primary border-brand-primary' 
                    : 'text-slate-300 border-transparent hover:text-brand-primary hover:border-brand-primary'}`}>
                  {item.name}
                </a>
              </li>
            )
          })}
        </ul>
        <button 
          id="navQuoteBtn"
          class="bg-brand-primary text-brand-deep px-8 py-4 font-black uppercase text-xs tracking-widest hover:bg-brand-accent hover:text-white transition-all shadow-[6px_6px_0px_#39a9f5] cursor-pointer"
        >
          Get Quote
        </button>
      </div>

      <button id="mobileMenuBtn" class="lg:hidden text-white cursor-pointer hover:text-brand-primary transition-colors">
        <Fragment set:html={icons.menu} />
      </button>
    </div>
  </nav>

  <!-- Mobile Overlay -->
  <div id="mobileMenuOverlay" class="fixed inset-0 bg-brand-deep/80 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300"></div>

  <!-- Mobile Sidebar -->
  <div id="mobileMenu" class="fixed inset-y-0 right-0 w-[80vw] max-w-sm bg-brand-deep text-white shadow-2xl z-[70] transform translate-x-full transition-transform duration-300 flex flex-col border-l-4 border-brand-primary">
    <div class="p-6 flex justify-between items-center border-b border-white/10">
      <span class="text-xl font-black uppercase tracking-widest italic">Menu</span>
      <button id="closeMenuBtn" class="text-slate-400 hover:text-brand-primary transition-colors cursor-pointer">
        <Fragment set:html={icons.close} />
      </button>
    </div>
    
    <ul class="flex flex-col p-6 gap-6 overflow-y-auto">
      {navItems.map(item => {
        const isItemActive = (item.name === 'Home' && currentPath === '') || 
                             (item.href.replace(/^\/|\/$/g, '') === currentPath && currentPath !== '');
        return (
          <li>
            <a href={item.href} class={`mobile-nav-link block text-lg font-bold uppercase tracking-widest pb-2 border-b transition-colors
              ${isItemActive 
                ? 'text-brand-primary border-brand-primary' 
                : 'text-white border-white/5 hover:text-brand-primary hover:border-brand-primary'}`}>
              {item.name}
            </a>
          </li>
        )
      })}
      <li class="mt-4">
        <button id="mobileQuoteBtn" class="w-full bg-brand-primary text-brand-deep p-5 font-black uppercase tracking-widest text-sm shadow-[4px_4px_0px_#39a9f5] hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all">
          Get a Quote
        </button>
      </li>
    </ul>
  </div>
</header>

<script>
  const openQuoteModal = () => {
    const modal = document.getElementById('quoteModal');
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  };

  const navQuoteBtn = document.getElementById('navQuoteBtn');
  navQuoteBtn?.addEventListener('click', openQuoteModal);

  const menuBtn = document.getElementById('mobileMenuBtn');
  const closeMenuBtn = document.getElementById('closeMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  const overlay = document.getElementById('mobileMenuOverlay');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  const openMenu = () => {
    if (overlay && mobileMenu) {
      overlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        overlay.classList.remove('opacity-0');
        mobileMenu.classList.remove('translate-x-full');
      });
      document.body.style.overflow = 'hidden';
    }
  };

  const closeMenu = () => {
    if (overlay && mobileMenu) {
      overlay.classList.add('opacity-0');
      mobileMenu.classList.add('translate-x-full');
      setTimeout(() => {
        overlay.classList.add('hidden');
      }, 300);
      
      const quoteModal = document.getElementById('quoteModal');
      if (!quoteModal || quoteModal.classList.contains('hidden')) {
        document.body.style.overflow = 'auto';
      }
    }
  };

  menuBtn?.addEventListener('click', openMenu);
  closeMenuBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);
  mobileLinks.forEach(link => link.addEventListener('click', closeMenu));

  const mobileQuoteBtn = document.getElementById('mobileQuoteBtn');
  mobileQuoteBtn?.addEventListener('click', () => {
    closeMenu();
    setTimeout(openQuoteModal, 150);
  });
</script>