---
// Swapped to your local uploaded image
const aboutImage = '/images/gallery15.jpg'; 

const icons = {
  check: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`
};
---

<section id="about" class="py-24 md:py-32 bg-white relative z-10 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center mb-20">
      
      <div class="relative fade-up-element">
        <div class="absolute -inset-4 bg-slate-100 z-0 transform -skew-y-2"></div>
        <img 
          src={aboutImage} 
          alt="JMS Multi-Service Solutions Working on Site" 
          class="relative z-10 w-full h-[400px] md:h-[500px] lg:h-[650px] object-cover border-l-8 border-brand-primary shadow-2xl"
        />
        <div class="absolute -bottom-6 -right-6 bg-brand-deep text-white p-6 shadow-xl z-20 flex flex-col items-center justify-center border-b-4 border-brand-accent hidden md:flex">
          <span class="text-4xl font-black text-brand-accent leading-none">100<span class="text-2xl">%</span></span>
          <span class="text-xs font-bold uppercase tracking-widest mt-1">Reliability</span>
        </div>
      </div>

      <div class="fade-up-element delay-100">
        <h2 class="text-sm font-black uppercase tracking-[0.2em] text-brand-primary mb-2">About JMS Solutions</h2>
        <h3 class="text-4xl md:text-5xl font-black text-brand-deep uppercase tracking-tighter mb-6 leading-tight">
          One Call. <br/><span class="text-brand-accent">Complete Solutions.</span>
        </h3>
        <p class="text-slate-500 font-medium text-lg leading-relaxed mb-6">
          We are a fully insured, professional property maintenance company serving Hull, East Riding, and North Lincolnshire. Our reputation is built on hard work, arriving on time, and delivering exceptional results for both domestic and commercial properties.
        </p>
        <p class="text-slate-500 font-medium text-lg leading-relaxed mb-8">
          We take pride in turning overgrown, unmanageable outdoor spaces back into clean, tidy areas you can enjoy. From regular garden maintenance and powerful jet washing to handyman repairs and gutter clearing, our friendly team is ready to help bring your property back to life.
        </p>
        
        <ul class="space-y-4 font-bold text-brand-deep mb-10">
          <li class="flex items-center gap-3"><span class="text-brand-primary"><Fragment set:html={icons.check} /></span> Reliable, Professional & Fully Insured</li>
          <li class="flex items-center gap-3"><span class="text-brand-primary"><Fragment set:html={icons.check} /></span> Free, No-Obligation Quotes</li>
          <li class="flex items-center gap-3"><span class="text-brand-primary"><Fragment set:html={icons.check} /></span> Domestic & Commercial Services</li>
        </ul>

        <button class="about-quote-btn bg-brand-deep text-white px-10 py-5 font-black uppercase text-sm tracking-[0.2em] hover:bg-brand-primary transition-all shadow-[6px_6px_0px_#39a9f5] cursor-pointer border border-transparent">
          Get Your Free Quote
        </button>
      </div>

    </div>

    <!-- Stats Section -->
    <div id="stats-section" class="bg-brand-deep text-white p-10 md:p-16 shadow-2xl border-t-4 border-brand-primary fade-up-element delay-200">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-x divide-white/10">
        
        <div class="flex flex-col items-center">
          <div class="text-4xl md:text-5xl font-black text-brand-accent mb-2 flex">
            <!-- Updated to 100+ to better reflect a growing business -->
            <span class="stat-number" data-target="50">1</span><span class="text-white">+</span>
          </div>
          <span class="text-xs md:text-sm font-bold uppercase tracking-widest text-slate-400">Properties Maintained</span>
        </div>

        <div class="flex flex-col items-center">
          <div class="text-4xl md:text-5xl font-black text-brand-accent mb-2 flex">
            <span class="stat-number" data-target="100">1</span><span class="text-white">%</span>
          </div>
          <span class="text-xs md:text-sm font-bold uppercase tracking-widest text-slate-400">Fully Insured</span>
        </div>

        <div class="flex flex-col items-center">
          <div class="text-4xl md:text-5xl font-black text-brand-accent mb-2 flex">
            <span class="stat-number" data-target="5">1</span><span class="text-white">★</span>
          </div>
          <span class="text-xs md:text-sm font-bold uppercase tracking-widest text-slate-400">Customer Reviews</span>
        </div>

        <div class="flex flex-col items-center">
          <div class="text-4xl md:text-5xl font-black text-brand-primary mb-2 flex">
            <span class="stat-number" data-target="30">1</span><span class="text-white">%</span>
          </div>
          <span class="text-xs md:text-sm font-bold uppercase tracking-widest text-slate-400">Off First Service*</span>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .fade-up-element {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1), transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .fade-up-element.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .delay-100 { transition-delay: 150ms; }
  .delay-200 { transition-delay: 300ms; }
</style>

<script>
  // 1. SCROLL FADE-UP ANIMATION OBSERVER
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.15
  };

  const fadeObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, observerOptions);

  document.querySelectorAll('#about .fade-up-element').forEach((el) => {
    fadeObserver.observe(el);
  });

  // 2. NUMBER COUNTING ANIMATION (TS-SAFE)
  const statsSection = document.getElementById('stats-section');
  const statNumbers = document.querySelectorAll('.stat-number');
  let animated = false; 

  const animateNumbers = () => {
    statNumbers.forEach(stat => {
      const el = stat as HTMLElement;
      const targetAttr = el.getAttribute('data-target');
      
      if (!targetAttr) return;

      const target = parseInt(targetAttr);
      const duration = 2000; 
      const increment = target / (duration / 16); 
      
      let current = 1;

      const updateCounter = () => {
        current += increment;
        if (current < target) {
          el.innerText = Math.ceil(current).toString();
          requestAnimationFrame(updateCounter);
        } else {
          el.innerText = target.toString();
        }
      };
      
      updateCounter();
    });
  };

  if (statsSection) {
    const statsObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !animated) {
          animated = true;
          animateNumbers();
        }
      });
    }, { threshold: 0.5 });

    statsObserver.observe(statsSection);
  }

  // 3. QUOTE BUTTON LOGIC
  const quoteBtn = document.querySelector('.about-quote-btn');
  quoteBtn?.addEventListener('click', () => {
    const modal = document.getElementById('quoteModal');
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  });
</script>