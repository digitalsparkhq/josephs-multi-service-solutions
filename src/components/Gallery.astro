---
// 1. Import Astro's built-in optimized Image component
import { Image } from 'astro:assets';

// 2. Explicitly import all local images from the assets folder
import gallery10 from '../assets/gallery10.jpg';
import gallery11 from '../assets/gallery11.jpg';
import gallery1 from '../assets/gallery1.jpg';
import gallery2 from '../assets/gallery2.jpg';
import gallery3 from '../assets/gallery3.jpg';
import gallery12 from '../assets/gallery12.jpg';
import gallery4 from '../assets/gallery4.jpg';
import gallery5 from '../assets/gallery5.jpg';
import gallery6 from '../assets/gallery6.jpg';
import gallery7 from '../assets/gallery7.jpg';
import gallery8 from '../assets/gallery8.jpg';
import gallery9 from '../assets/gallery9.jpg';

const facebookPhotosLink = "https://www.facebook.com/people/Josephs-Multi-Service-Solutions/61590378479449/?sk=photos";

// 3. Map the imported modules instead of standard string paths
const images = [
  { src: gallery10, alt: "Garden clearance and maintenance project" },
  { src: gallery11, alt: "Jet washing and driveway cleaning" },
  { src: gallery1, alt: "Overgrown garden transformation" },
  { src: gallery2, alt: "Handyman and property repairs" },
  { src: gallery3, alt: "Gutter cleaning and roofline maintenance" },
  { src: gallery12, alt: "Full property exterior clean and tidy up" },
  { src: gallery4, alt: "Lawn care, strimming, and hedge trimming" },
  { src: gallery5, alt: "Patio and block paving jet washing restoration" },
  { src: gallery6, alt: "Fencing, decking, and handyman installation" },
  { src: gallery7, alt: "Commercial exterior cleaning and property upkeep" },
  { src: gallery8, alt: "Weed removal and seasonal garden tidy-up" },
  { src: gallery9, alt: "General property maintenance and repairs" }
];

const icons = {
  zoom: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>`,
  close: `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>`,
  facebook: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>`
};
---

<section id="gallery" class="py-24 md:py-32 bg-white relative z-10 overflow-hidden">
  
  <div class="absolute inset-0 pointer-events-none z-0" style="mask-image: linear-gradient(to bottom, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 85%, transparent 100%);">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="clean-gallery-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
          <path d="M0 100 V 50 Q 25 25 50 50 T 100 50 V 100 z" fill="none" stroke="#f1f5f9" stroke-width="1" opacity="0.5"/>
          <circle cx="50" cy="50" r="1.5" fill="#e2e8f0"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#clean-gallery-pattern)" />
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10">
    <div class="text-center mb-16 fade-up-element">
      <h2 class="text-sm font-black uppercase tracking-[0.2em] text-brand-primary mb-2">Our Recent Work</h2>
      <h3 class="text-4xl md:text-5xl font-black text-brand-deep uppercase tracking-tighter mb-6">
        Project <span class="text-brand-accent">Gallery</span>
      </h3>
      <div class="w-24 h-2 bg-brand-primary mx-auto mb-6"></div>
      <p class="text-slate-500 font-bold max-w-2xl mx-auto md:text-lg">
        See the transformative results of our garden clearances, jet washing, and property maintenance projects across East Riding & North Lincs.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 md:gap-8">
      {images.map((img, index) => (
        <div class={`relative aspect-[4/3] overflow-hidden group cursor-pointer bg-slate-100 border-2 border-slate-200 shadow-[8px_8px_0px_#e2e8f0] hover:shadow-[12px_12px_0px_#8ebe29] hover:border-brand-primary transition-all duration-300 fade-up-element delay-${(index % 3) * 100 + 100}`}>
          
          <Image 
            src={img.src} 
            alt={img.alt} 
            width={600}
            class="gallery-img w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            data-full-src={img.src.src} 
            loading="lazy"
          />
          
          <div class="absolute inset-0 bg-brand-deep/70 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
            <div class="text-brand-accent transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
              <Fragment set:html={icons.zoom} />
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 flex flex-col items-center justify-center text-center fade-up-element delay-200">
      <p class="text-slate-500 font-bold mb-6 text-lg max-w-xl mx-auto">
        We complete new transformations every single week! Check out our social media to see our latest daily projects.
      </p>
      <a href={facebookPhotosLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-[#1877F2] text-white px-8 py-5 font-black uppercase text-sm tracking-[0.15em] shadow-[6px_6px_0px_#111827] hover:translate-y-1 hover:translate-x-1 hover:shadow-[2px_2px_0px_#111827] transition-all cursor-pointer">
        <span class="mt-[-2px]"><Fragment set:html={icons.facebook} /></span>
        View More Work on Facebook
      </a>
    </div>

  </div>

  <div id="galleryLightbox" class="fixed inset-0 z-[100] bg-brand-deep/95 backdrop-blur-md hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <button id="closeLightboxBtn" class="absolute top-6 right-6 text-white hover:text-brand-accent transition-colors z-[110] cursor-pointer">
      <Fragment set:html={icons.close} />
    </button>
    <img id="lightboxImage" src="" alt="Expanded View" class="max-w-[90vw] max-h-[90vh] object-contain shadow-2xl scale-95 transition-transform duration-300" />
  </div>
</section>

<style>
  .fade-up-element { opacity: 0; transform: translateY(40px); transition: opacity 0.8s ease-out, transform 0.8s ease-out; }
  .fade-up-element.is-visible { opacity: 1; transform: translateY(0); }
  .delay-100 { transition-delay: 100ms; }
  .delay-200 { transition-delay: 200ms; }
  .delay-300 { transition-delay: 300ms; }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('#gallery .fade-up-element').forEach((el) => observer.observe(el));

  const lightbox = document.getElementById('galleryLightbox');
  const lightboxImage = document.getElementById('lightboxImage') as HTMLImageElement | null;
  const closeBtn = document.getElementById('closeLightboxBtn');
  const galleryImgs = document.querySelectorAll('.gallery-img');

  const openLightbox = (src: string) => {
    if (lightbox && lightboxImage) {
      lightboxImage.src = src;
      lightbox.classList.remove('hidden');
      setTimeout(() => {
        lightbox.classList.remove('opacity-0');
        lightboxImage.classList.replace('scale-95', 'scale-100');
      }, 10);
      document.body.style.overflow = 'hidden';
    }
  };

  const closeLightbox = () => {
    if (lightbox && lightboxImage) {
      lightbox.classList.add('opacity-0');
      lightboxImage.classList.replace('scale-100', 'scale-95');
      setTimeout(() => {
        lightbox.classList.add('hidden');
        document.body.style.overflow = 'auto';
      }, 300);
    }
  };

  galleryImgs.forEach(img => {
    const parent = img.parentElement;
    const fullSrc = img.getAttribute('data-full-src');
    if (parent && fullSrc) {
      parent.addEventListener('click', () => openLightbox(fullSrc));
    }
  });

  closeBtn?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });
</script>