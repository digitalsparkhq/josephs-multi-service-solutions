---
const icons = {
  wash: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path><path d="M12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path></svg>`,
  roof: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>`,
  paving: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="3" y1="15" x2="21" y2="15"></line><line x1="9" y1="9" x2="9" y2="21"></line><line x1="15" y1="3" x2="15" y2="15"></line></svg>`,
  gutter: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h20"></path><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6"></path><line x1="12" y1="12" x2="12" y2="20"></line></svg>`,
  decking: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="14" width="20" height="8" rx="2"></rect><line x1="6" y1="14" x2="6" y2="22"></line><line x1="10" y1="14" x2="10" y2="22"></line><line x1="14" y1="14" x2="14" y2="22"></line><line x1="18" y1="14" x2="18" y2="22"></line><path d="M2 10h20"></path><path d="M6 10V4"></path><path d="M18 10V4"></path></svg>`,
  shield: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>`,
  check: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`
};

const secondaryServices = [
  { title: "Roof Repairs & Cleaning", desc: "From replacing missing tiles and fixing leaks to full hypochemical roof treatments, we protect and restore your home's most important asset.", icon: icons.roof },
  { title: "Block Paving Services", desc: "Expert block paving repairs, relaying sunken blocks, repointing, and full-scale paving installations for driveways and patios.", icon: icons.paving },
  { title: "Decking Restoration", desc: "Slippery, faded decking brought back to life. We pressure wash, treat, and seal timber and composite decking to ensure it looks pristine.", icon: icons.decking },
  { title: "Gutter Cleaning & Repair", desc: "Blocked gutters cause severe damp issues. We unblock, clean, and repair all guttering, fascias, and soffits to keep water flowing away safely.", icon: icons.gutter }
];
---

<section id="services" class="pt-40 md:pt-48 lg:pt-56 pb-24 px-4 bg-slate-50 relative z-10 overflow-hidden">
  
  <div class="absolute inset-0 pointer-events-none z-0" style="mask-image: linear-gradient(to bottom, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 85%, transparent 100%);">    
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="clean-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
          <path d="M0 100 V 50 Q 25 25 50 50 T 100 50 V 100 z" fill="none" stroke="#cbd5e1" stroke-width="0.5" opacity="0.3"/>
          <circle cx="50" cy="50" r="1" fill="#cbd5e1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#clean-pattern)" />
    </svg>
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    
    <div class="text-center mb-16 fade-up-element">
      <div class="flex flex-wrap justify-center gap-4 md:gap-8 mb-6 text-sm font-bold uppercase tracking-widest text-slate-600">
        <span class="flex items-center gap-2 text-brand-primary"><Fragment set:html={icons.shield} /> Fully Insured</span>
        <span class="flex items-center gap-2 text-brand-primary"><Fragment set:html={icons.check} /> Quality Workmanship</span>
        <span class="flex items-center gap-2 text-brand-primary"><Fragment set:html={icons.shield} /> Unbeatable Prices</span>
      </div>
      
      <h2 class="text-4xl md:text-5xl font-black text-brand-deep uppercase tracking-tighter mb-4">
        Our Core <span class="text-brand-accent">Services</span>
      </h2>
      <div class="w-24 h-2 bg-brand-primary mx-auto mb-6"></div>
      <p class="text-slate-500 font-bold max-w-2xl mx-auto md:text-lg">
        Professional exterior maintenance, repairs, and deep cleaning services. We don't just wash your property; we revive it.
      </p>
    </div>

    <div class="bg-brand-deep text-white border-l-8 border-brand-accent p-8 md:p-12 mb-10 shadow-2xl relative overflow-hidden group fade-up-element delay-100">
      
      <div class="absolute -right-10 -bottom-10 opacity-5 group-hover:opacity-10 transition-opacity transform scale-[3] z-0 pointer-events-none text-brand-primary">
        <Fragment set:html={icons.wash} />
      </div>

      <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
        <div class="max-w-3xl">
          <div class="text-brand-primary mb-4"><Fragment set:html={icons.wash} /></div>
          <h3 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-4 text-white">
            Driveway & Patio Revival
          </h3>
          <p class="text-slate-300 text-base md:text-lg font-medium leading-relaxed mb-6">
            Don't let weeds, moss, and grime ruin your home's curb appeal. We use advanced hypochemical treatments, high-power pressure washing, and soft washing techniques to restore block paving, tarmac, and natural stone. We finish every job with expert sanding and resin sealing to protect your investment for years to come.
          </p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-bold text-sm uppercase tracking-wider text-brand-accent mb-8">
            <li class="flex items-center gap-2"><Fragment set:html={icons.check} /> Deep Pressure Washing</li>
            <li class="flex items-center gap-2"><Fragment set:html={icons.check} /> Hypochemical Treatment</li>
            <li class="flex items-center gap-2"><Fragment set:html={icons.check} /> Block Paving Sanding</li>
            <li class="flex items-center gap-2"><Fragment set:html={icons.check} /> Protective Resin Sealing</li>
          </ul>
        </div>
        
        <div class="w-full md:w-auto flex-shrink-0">
          <button class="service-quote-btn w-full bg-brand-accent text-brand-deep px-8 py-5 font-black uppercase text-sm tracking-[0.2em] hover:bg-brand-primary hover:text-white transition-all shadow-[6px_6px_0px_#0073e6] cursor-pointer text-center block">
            Book a Clean
          </button>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {secondaryServices.map((service, index) => (
        <div class={`bg-white p-8 border-t-4 border-slate-200 hover:border-brand-primary transition-colors shadow-xl group relative overflow-hidden fade-up-element ${index % 2 === 0 ? 'delay-200' : 'delay-300'}`}>
          
          <div class="relative z-10">
            <div class="text-slate-400 group-hover:text-brand-primary transition-colors mb-6">
              <Fragment set:html={service.icon} />
            </div>
            <h3 class="text-xl md:text-2xl font-black uppercase text-brand-deep mb-3">
              {service.title}
            </h3>
            <p class="text-slate-500 font-medium mb-6 leading-relaxed">
              {service.desc}
            </p>
            <button class="service-quote-btn text-brand-accent font-bold uppercase tracking-widest text-xs flex items-center gap-2 hover:text-brand-primary transition-colors cursor-pointer group-hover:translate-x-2 transform duration-300 bg-transparent border-none p-0">
              Request Quote <span class="text-lg">→</span>
            </button>
          </div>
          
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .fade-up-element {
    opacity: 0;
    transform: translateY(50px);
    transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1), transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }
  
  .fade-up-element.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .delay-100 { transition-delay: 150ms; }
  .delay-200 { transition-delay: 300ms; }
  .delay-300 { transition-delay: 450ms; }
</style>

<script>
  // 1. Handle Quote Buttons
  const quoteButtons = document.querySelectorAll('.service-quote-btn');
  quoteButtons.forEach(button => {
    button.addEventListener('click', () => {
      const modal = document.getElementById('quoteModal');
      if (modal) {
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  // 2. Handle Scroll Fade-Up Animation
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.15 
  };

  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target); 
      }
    });
  }, observerOptions);

  document.querySelectorAll('.fade-up-element').forEach((el) => {
    observer.observe(el);
  });
</script>