---
const icons = {
  leaf: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`,
  wash: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path><path d="M12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path></svg>`,
  tool: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
  gutter: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h20"></path><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6"></path><line x1="12" y1="12" x2="12" y2="20"></line></svg>`,
  shovel: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 22v-5l5-5 5 5-5 5z"/><path d="M9.5 14.5 16 8"/><path d="m17 7-1.5-1.5a2.12 2.12 0 0 1 0-3a2.12 2.12 0 0 1 3 0l2 2a2.12 2.12 0 0 1 0 3A2.12 2.12 0 0 1 19 9l-2-2"/></svg>`,
  shield: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>`,
  check: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`
};

const secondaryServices = [
  { title: "Jet Washing Services", desc: "Powerful residential and commercial jet washing for driveways, patios, pathways, decking, and building exteriors. We clear the grime and restore your surfaces.", icon: icons.wash },
  { title: "Handyman Services", desc: "Reliable general repairs and property upkeep. Whether you need fencing, decking, shed installations, flat pack assembly, or fixture repairs, we've got you covered.", icon: icons.tool },
  { title: "Guttering & Roofline", desc: "Protect your property from water damage. We provide professional cleaning and clearing of blockages, alongside full installation and repair of all guttering systems.", icon: icons.gutter },
  { title: "Turfing & Lawn Care", desc: "Breathe new life into your garden with fresh turf installations, lawn repairs, and regular maintenance treatments to keep your grass healthy all year round.", icon: icons.shovel }
];
---

<section id="services" class="pt-40 md:pt-48 lg:pt-56 pb-24 px-4 bg-slate-50 relative z-10 overflow-hidden">
  
  <div class="absolute inset-0 pointer-events-none z-0" style="mask-image: linear-gradient(to bottom, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 85%, transparent 100%);">    
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="clean-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
          <path d="M0 100 V 50 Q 25 25 50 50 T 100 50 V 100 z" fill="none" stroke="#cbd5e1" stroke-width="0.5" opacity="0.3"/>
          <circle cx="50" cy="50" r="1" fill="#cbd5e1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#clean-pattern)" />
    </svg>
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    
    <div class="text-center mb-16 fade-up-element">
      <div class="flex flex-wrap justify-center gap-4 md:gap-8 mb-6 text-sm font-bold uppercase tracking-widest text-slate-600">
        <span class="flex items-center gap-2 text-brand-primary"><Fragment set:html={icons.shield} /> Fully Insured</span>
        <span class="flex items-center gap-2 text-brand-primary"><Fragment set:html={icons.check} /> Trusted Quality</span>
        <span class="flex items-center gap-2 text-brand-primary"><Fragment set:html={icons.shield} /> Free Quotes</span>
      </div>
      
      <h2 class="text-4xl md:text-5xl font-black text-brand-deep uppercase tracking-tighter mb-4">
        Our Core <span class="text-brand-primary">Services</span>
      </h2>
      <div class="w-24 h-2 bg-brand-accent mx-auto mb-6"></div>
      <p class="text-slate-500 font-bold max-w-2xl mx-auto md:text-lg uppercase tracking-wider">
        One Call. Complete Solutions.
      </p>
      <p class="text-slate-500 font-medium max-w-2xl mx-auto md:text-lg mt-2">
        Domestic & commercial property maintenance, garden clearances, and professional jet washing across East Riding & North Lincs.
      </p>
    </div>

    <!-- Featured Service: Garden Maintenance -->
    <div class="bg-brand-deep text-white border-l-8 border-brand-primary p-8 md:p-12 mb-10 shadow-2xl relative overflow-hidden group fade-up-element delay-100">
      
      <div class="absolute -right-10 -bottom-10 opacity-5 group-hover:opacity-10 transition-opacity transform scale-[3] z-0 pointer-events-none text-brand-primary">
        <Fragment set:html={icons.leaf} />
      </div>

      <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
        <div class="max-w-3xl">
          <div class="text-brand-primary mb-4"><Fragment set:html={icons.leaf} /></div>
          <h3 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-4 text-white">
            Garden Maintenance & Clearances
          </h3>
          <p class="text-slate-300 text-base md:text-lg font-medium leading-relaxed mb-6">
            We take pride in turning overgrown outdoor spaces back into clean, tidy, and manageable areas. From full garden clearances to ongoing maintenance plans, our team works hard to bring your property up to a standard that can be easily maintained all year round. 
          </p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-bold text-sm uppercase tracking-wider text-brand-primary mb-8">
            <li class="flex items-center gap-2"><Fragment set:html={icons.check} /> Lawn Care & Strimming</li>
            <li class="flex items-center gap-2"><Fragment set:html={icons.check} /> Weed & Ivy Removal</li>
            <li class="flex items-center gap-2"><Fragment set:html={icons.check} /> Full Garden Clearances</li>
            <li class="flex items-center gap-2"><Fragment set:html={icons.check} /> Regular Maintenance Plans</li>
          </ul>
        </div>
        
        <div class="w-full md:w-auto flex-shrink-0">
          <!-- Button styled with the Accent blue, maintaining high contrast -->
          <button class="service-quote-btn w-full bg-brand-accent text-white px-8 py-5 font-black uppercase text-sm tracking-[0.2em] hover:bg-brand-primary hover:text-white transition-all shadow-[6px_6px_0px_#111827] cursor-pointer text-center block">
            Book a Service
          </button>
        </div>
      </div>
    </div>

    <!-- Secondary Grid Services -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {secondaryServices.map((service, index) => (
        <div class={`bg-white p-8 border-t-4 border-slate-200 hover:border-brand-accent transition-colors shadow-xl group relative overflow-hidden fade-up-element ${index % 2 === 0 ? 'delay-200' : 'delay-300'}`}>
          
          <div class="relative z-10">
            <div class="text-slate-400 group-hover:text-brand-accent transition-colors mb-6">
              <Fragment set:html={service.icon} />
            </div>
            <h3 class="text-xl md:text-2xl font-black uppercase text-brand-deep mb-3">
              {service.title}
            </h3>
            <p class="text-slate-500 font-medium mb-6 leading-relaxed">
              {service.desc}
            </p>
            <button class="service-quote-btn text-brand-primary font-bold uppercase tracking-widest text-xs flex items-center gap-2 hover:text-brand-accent transition-colors cursor-pointer group-hover:translate-x-2 transform duration-300 bg-transparent border-none p-0">
              Request Quote <span class="text-lg">→</span>
            </button>
          </div>
          
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .fade-up-element {
    opacity: 0;
    transform: translateY(50px);
    transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1), transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }
  
  .fade-up-element.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .delay-100 { transition-delay: 150ms; }
  .delay-200 { transition-delay: 300ms; }
  .delay-300 { transition-delay: 450ms; }
</style>

<script>
  // 1. Handle Quote Buttons
  const quoteButtons = document.querySelectorAll('.service-quote-btn');
  quoteButtons.forEach(button => {
    button.addEventListener('click', () => {
      const modal = document.getElementById('quoteModal');
      if (modal) {
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  // 2. Handle Scroll Fade-Up Animation
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.15 
  };

  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target); 
      }
    });
  }, observerOptions);

  document.querySelectorAll('.fade-up-element').forEach((el) => {
    observer.observe(el);
  });
</script>